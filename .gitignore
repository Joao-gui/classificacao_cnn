# ==========================================================
# Dataset
# ==========================================================

# Ignorar imagens do dataset
datasets/*/train/*
datasets/*/val/*
datasets/*/test/*

# Caso queira manter a estrutura das pastas
!datasets/*/train/.gitkeep
!datasets/*/val/.gitkeep
!datasets/*/test/.gitkeep

# Arquivos auxiliares do dataset podem ficar
# datasets/*/fonte_do_dataset.txt


